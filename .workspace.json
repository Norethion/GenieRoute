{
  "$schema": "../workspace-launcher/workspace.schema.json",
  "name": "GenieRoute AI",
  "description": "Docker + Express + React seyahat planlayıcı",
  "icon": "🗺️",
  "color": "#3b82f6",
  "ports": [3001, 5173, 5432],
  "links": [
    { "label": "Frontend",    "url": "http://localhost:5173" },
    { "label": "Backend API", "url": "http://localhost:3001" },
    { "label": "API Health",  "url": "http://localhost:3001/api/health" }
  ],
  "actions": [
    {
      "id": "start-all",
      "label": "Tümünü Başlat",
      "group": "lifecycle",
      "primary": true,
      "steps": [
        { "ensureContainer": "postgres" },
        { "id": "backend",  "label": "Backend (3001)",  "run": "npm run dev", "cwd": "backend",  "background": true, "port": 3001 },
        { "id": "frontend", "label": "Frontend (5173)", "run": "npm run dev", "cwd": "frontend", "background": true, "port": 5173 }
      ]
    },
    {
      "id": "stop",
      "label": "Durdur",
      "group": "lifecycle",
      "steps": [
        { "run": "docker-compose stop" },
        { "freePort": 3001 },
        { "freePort": 5173 }
      ]
    },
    {
      "id": "restart",
      "label": "Yeniden Başlat",
      "group": "lifecycle",
      "steps": [
        { "run": "docker-compose restart" },
        { "freePort": 3001 },
        { "freePort": 5173 },
        { "sleep": 1500 },
        { "id": "backend",  "label": "Backend (3001)",  "run": "npm run dev", "cwd": "backend",  "background": true, "port": 3001 },
        { "id": "frontend", "label": "Frontend (5173)", "run": "npm run dev", "cwd": "frontend", "background": true, "port": 5173 }
      ]
    },
    {
      "id": "start:db",
      "label": "Sadece DB",
      "group": "lifecycle",
      "steps": [{ "ensureContainer": "postgres" }]
    },
    {
      "id": "start:backend",
      "label": "Sadece Backend",
      "group": "lifecycle",
      "steps": [
        { "id": "backend", "label": "Backend (3001)", "run": "npm run dev", "cwd": "backend", "background": true, "port": 3001, "ensureContainers": ["postgres"] }
      ]
    },
    {
      "id": "start:frontend",
      "label": "Sadece Frontend",
      "group": "lifecycle",
      "steps": [
        { "id": "frontend", "label": "Frontend (5173)", "run": "npm run dev", "cwd": "frontend", "background": true, "port": 5173 }
      ]
    },
    {
      "id": "build",
      "label": "Production Build",
      "group": "modes",
      "steps": [
        { "run": "npm run build", "cwd": "frontend" }
      ]
    },
    {
      "id": "start-prod",
      "label": "Prod Build + Start",
      "group": "modes",
      "steps": [
        { "ensureContainer": "postgres" },
        { "run": "npm run build", "cwd": "frontend" },
        { "id": "backend",     "label": "Backend (3001)",       "run": "npm start", "cwd": "backend", "background": true, "port": 3001 },
        { "id": "frontend-pv", "label": "Frontend Preview (5173)", "run": "npm run preview -- --port 5173", "cwd": "frontend", "background": true, "port": 5173 }
      ]
    },
    {
      "id": "first-setup",
      "label": "İlk Kurulum",
      "group": "setup",
      "steps": [
        { "ensureContainer": "postgres" },
        { "run": "npm install", "cwd": "backend" },
        { "run": "npm install", "cwd": "frontend" }
      ]
    },
    {
      "id": "install",
      "label": "Bağımlılıkları Kur",
      "group": "setup",
      "steps": [
        { "run": "npm install", "cwd": "backend" },
        { "run": "npm install", "cwd": "frontend" }
      ]
    },
    {
      "id": "check-env",
      "label": "Runtime Kontrolü",
      "group": "setup",
      "steps": [
        { "run": "node --version", "continueOnError": true },
        { "run": "npm --version", "continueOnError": true },
        { "run": "docker --version", "continueOnError": true },
        { "run": "docker-compose --version", "continueOnError": true }
      ]
    },
    {
      "id": "db:migrate",
      "label": "Migrate (manuel)",
      "group": "db",
      "steps": [
        { "ensureContainer": "postgres" },
        { "run": "echo Migration backend kalkışında otomatik uygulanır. Bu aksiyon mevcut migrasyon dosyalarını listeler.", "continueOnError": true },
        { "run": "dir /b database\\migrations\\*.sql", "continueOnError": true }
      ]
    },
    {
      "id": "db:studio",
      "label": "psql Shell",
      "group": "db",
      "steps": [
        { "ensureContainer": "postgres" },
        { "run": "docker-compose exec postgres psql -U genieroute -d genieroute" }
      ]
    },
    {
      "id": "tests",
      "label": "Backend Lint",
      "group": "quality",
      "steps": [
        { "run": "npm run lint", "cwd": "backend" }
      ]
    },
    {
      "id": "lint",
      "label": "Lint",
      "group": "quality",
      "steps": [
        { "run": "npm run lint", "cwd": "backend" }
      ]
    },
    {
      "id": "status",
      "label": "Durum",
      "group": "diag",
      "steps": [
        { "run": "docker-compose ps", "continueOnError": true },
        { "run": "netstat -an | findstr \":3001 :5173 :5432\" | findstr \"LISTENING\"", "continueOnError": true }
      ]
    },
    {
      "id": "logs",
      "label": "Docker Logları",
      "group": "diag",
      "steps": [
        { "run": "docker-compose logs -f --tail=100" }
      ]
    },
    {
      "id": "health",
      "label": "Health Check",
      "group": "diag",
      "steps": [
        { "run": "powershell -NoProfile -Command \"try { (Invoke-WebRequest -Uri 'http://localhost:3001/api/health' -UseBasicParsing -TimeoutSec 5).Content } catch { Write-Host '[X] backend erişilemiyor' }\"" }
      ]
    },
    {
      "id": "open",
      "label": "Frontend'i Aç",
      "group": "links",
      "steps": [{ "run": "start \"\" \"http://localhost:5173\"" }]
    },
    {
      "id": "tunnel",
      "label": "Cloudflare Tunnel (Frontend)",
      "group": "share",
      "steps": [
        { "run": "if not exist \"%USERPROFILE%\\.tools\\cloudflared.exe\" ( powershell -NoProfile -Command \"New-Item -ItemType Directory -Path '$env:USERPROFILE\\.tools' -Force | Out-Null; Invoke-WebRequest -Uri 'https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-windows-amd64.exe' -OutFile '$env:USERPROFILE\\.tools\\cloudflared.exe' -UseBasicParsing\" )" },
        { "id": "tunnel-fe", "label": "Tunnel → 5173", "run": "\"%USERPROFILE%\\.tools\\cloudflared.exe\" tunnel --url http://localhost:5173 --no-autoupdate", "background": true }
      ]
    },
    {
      "id": "reset-db",
      "label": "Veritabanını Sıfırla",
      "group": "danger",
      "destructive": true,
      "confirm": "SIL",
      "confirmText": "Tüm seyahat planları ve mekan verileri silinir. Geri alınamaz.",
      "steps": [{ "run": "docker-compose down -v" }]
    }
  ]
}
